{"surah":84,"src":"quran.com v4 (word-by-word EN/BN)","ayahs":[{"a":1,"w":[{"t":"إِذَا","en":"When","bn":"যখন","tr":"idhā","au":"wbw/084_001_001.mp3"},{"t":"ٱلسَّمَآءُ","en":"the sky","bn":"আকাশ","tr":"l-samāu","au":"wbw/084_001_002.mp3"},{"t":"ٱنشَقَّتْ","en":"is split asunder","bn":"ফেটে পড়বে","tr":"inshaqqat","au":"wbw/084_001_003.mp3"}]},{"a":2,"w":[{"t":"وَأَذِنَتْ","en":"And has listened","bn":"এবং সে নির্দেশ পালন করবে","tr":"wa-adhinat","au":"wbw/084_002_001.mp3"},{"t":"لِرَبِّهَا","en":"to its Lord","bn":"তার রবের","tr":"lirabbihā","au":"wbw/084_002_002.mp3"},{"t":"وَحُقَّتْ","en":"and was obligated","bn":"ও এটাই তার করণীয়","tr":"waḥuqqat","au":"wbw/084_002_003.mp3"}]},{"a":3,"w":[{"t":"وَإِذَا","en":"And when","bn":"এবং যখন","tr":"wa-idhā","au":"wbw/084_003_001.mp3"},{"t":"ٱلْأَرْضُ","en":"the earth","bn":"পৃথিবী","tr":"l-arḍu","au":"wbw/084_003_002.mp3"},{"t":"مُدَّتْ","en":"is spread","bn":"সম্প্রসারিত করা হবে","tr":"muddat","au":"wbw/084_003_003.mp3"}]},{"a":4,"w":[{"t":"وَأَلْقَتْ","en":"And has cast out","bn":"এবং নিক্ষেপ করবে","tr":"wa-alqat","au":"wbw/084_004_001.mp3"},{"t":"مَا","en":"what","bn":"যা","tr":"mā","au":"wbw/084_004_002.mp3"},{"t":"فِيهَا","en":"(is) in it","bn":"তার মধ্যে আছে","tr":"fīhā","au":"wbw/084_004_003.mp3"},{"t":"وَتَخَلَّتْ","en":"and becomes empty","bn":"এবং তা শূন্য হয়ে যাবে","tr":"watakhallat","au":"wbw/084_004_004.mp3"}]},{"a":5,"w":[{"t":"وَأَذِنَتْ","en":"And has listened","bn":"এবং সে নির্দেশ পালন করবে","tr":"wa-adhinat","au":"wbw/084_005_001.mp3"},{"t":"لِرَبِّهَا","en":"to its Lord","bn":"তার রবের","tr":"lirabbihā","au":"wbw/084_005_002.mp3"},{"t":"وَحُقَّتْ","en":"and was obligated","bn":"এবং এটাই তার জন্য করণীয়","tr":"waḥuqqat","au":"wbw/084_005_003.mp3"}]},{"a":6,"w":[{"t":"يَـٰٓأَيُّهَا","en":"O","bn":"হে","tr":"yāayyuhā","au":"wbw/084_006_001.mp3"},{"t":"ٱلْإِنسَـٰنُ","en":"mankind","bn":"মানুষ","tr":"l-insānu","au":"wbw/084_006_002.mp3"},{"t":"إِنَّكَ","en":"Indeed, you","bn":"নিশ্চয়ই তুমি","tr":"innaka","au":"wbw/084_006_003.mp3"},{"t":"كَادِحٌ","en":"(are) laboring","bn":"পরিশ্রমকারী","tr":"kādiḥun","au":"wbw/084_006_004.mp3"},{"t":"إِلَىٰ","en":"to","bn":"দিকে","tr":"ilā","au":"wbw/084_006_005.mp3"},{"t":"رَبِّكَ","en":"your Lord","bn":"তোমার রবের","tr":"rabbika","au":"wbw/084_006_006.mp3"},{"t":"كَدْحًۭا","en":"(with) exertion","bn":"কঠোর পরিশ্রম","tr":"kadḥan","au":"wbw/084_006_007.mp3"},{"t":"فَمُلَـٰقِيهِ","en":"and you (will) meet Him","bn":"অতঃপর তাঁর (সাথে) সাক্ষাত করবে","tr":"famulāqīhi","au":"wbw/084_006_008.mp3"}]},{"a":7,"w":[{"t":"فَأَمَّا","en":"Then as for","bn":"অতঃপর (তার) ব্যাপার","tr":"fa-ammā","au":"wbw/084_007_001.mp3"},{"t":"مَنْ","en":"(him) who","bn":"যাকে","tr":"man","au":"wbw/084_007_002.mp3"},{"t":"أُوتِىَ","en":"is given","bn":"দেয়া হবে","tr":"ūtiya","au":"wbw/084_007_003.mp3"},{"t":"كِتَـٰبَهُۥ","en":"his record","bn":"তার আমলনামা","tr":"kitābahu","au":"wbw/084_007_004.mp3"},{"t":"بِيَمِينِهِۦ","en":"in his right (hand)","bn":"তার ডান হাতে","tr":"biyamīnihi","au":"wbw/084_007_005.mp3"}]},{"a":8,"w":[{"t":"فَسَوْفَ","en":"Then soon","bn":"অতঃপর শীঘ্র","tr":"fasawfa","au":"wbw/084_008_001.mp3"},{"t":"يُحَاسَبُ","en":"his account will be taken","bn":"হিসাব নেয়া হবে (তার)","tr":"yuḥāsabu","au":"wbw/084_008_002.mp3"},{"t":"حِسَابًۭا","en":"an account","bn":"হিসাব","tr":"ḥisāban","au":"wbw/084_008_003.mp3"},{"t":"يَسِيرًۭا","en":"easy","bn":"সহজ","tr":"yasīran","au":"wbw/084_008_004.mp3"}]},{"a":9,"w":[{"t":"وَيَنقَلِبُ","en":"And he will return","bn":"এবং ফিরবে","tr":"wayanqalibu","au":"wbw/084_009_001.mp3"},{"t":"إِلَىٰٓ","en":"to","bn":"কাছে","tr":"ilā","au":"wbw/084_009_002.mp3"},{"t":"أَهْلِهِۦ","en":"his people","bn":"তার আপনজনের","tr":"ahlihi","au":"wbw/084_009_003.mp3"},{"t":"مَسْرُورًۭا","en":"happily","bn":"আনন্দচিত্তে","tr":"masrūran","au":"wbw/084_009_004.mp3"}]},{"a":10,"w":[{"t":"وَأَمَّا","en":"But as for","bn":"আর (তার) ব্যাপার","tr":"wa-ammā","au":"wbw/084_010_001.mp3"},{"t":"مَنْ","en":"(him) who","bn":"যাকে","tr":"man","au":