wbw/092_012_003.mp3"}]},{"a":13,"w":[{"t":"وَإِنَّ","en":"And indeed","bn":"এবং নিশ্চয়ই","tr":"wa-inna","au":"wbw/092_013_001.mp3"},{"t":"لَنَا","en":"for Us","bn":"আমরা মালিক","tr":"lanā","au":"wbw/092_013_002.mp3"},{"t":"لَلْـَٔاخِرَةَ","en":"(is) the Hereafter","bn":"পরকালের","tr":"lalākhirata","au":"wbw/092_013_003.mp3"},{"t":"وَٱلْأُولَىٰ","en":"and the first (life)","bn":"ও ইহকালের","tr":"wal-ūlā","au":"wbw/092_013_004.mp3"}]},{"a":14,"w":[{"t":"فَأَنذَرْتُكُمْ","en":"So I warn you","bn":"অতএব তোমাদেরকে আমি সতর্ক করছি","tr":"fa-andhartukum","au":"wbw/092_014_001.mp3"},{"t":"نَارًۭا","en":"(of) a Fire","bn":"অগ্নির","tr":"nāran","au":"wbw/092_014_002.mp3"},{"t":"تَلَظَّىٰ","en":"blazing","bn":"জ্বলন্ত","tr":"talaẓẓā","au":"wbw/092_014_003.mp3"}]},{"a":15,"w":[{"t":"لَا","en":"Not","bn":"না","tr":"lā","au":"wbw/092_015_001.mp3"},{"t":"يَصْلَىٰهَآ","en":"will burn (in) it","bn":"এতে প্রবেশ করবে","tr":"yaṣlāhā","au":"wbw/092_015_002.mp3"},{"t":"إِلَّا","en":"except","bn":"এ ছাড়া","tr":"illā","au":"wbw/092_015_003.mp3"},{"t":"ٱلْأَشْقَى","en":"the most wretched","bn":"নিতান্ত হতভাগ্য","tr":"l-ashqā","au":"wbw/092_015_004.mp3"}]},{"a":16,"w":[{"t":"ٱلَّذِى","en":"The one who","bn":"যে","tr":"alladhī","au":"wbw/092_016_001.mp3"},{"t":"كَذَّبَ","en":"denied","bn":"মিথ্যারোপ করলো","tr":"kadhaba","au":"wbw/092_016_002.mp3"},{"t":"وَتَوَلَّىٰ","en":"and turned away","bn":"এবং মুখ ফিরালো","tr":"watawallā","au":"wbw/092_016_003.mp3"}]},{"a":17,"w":[{"t":"وَسَيُجَنَّبُهَا","en":"But will be removed from it","bn":"এবং এ থেকে দূরে রাখা হবে","tr":"wasayujannabuhā","au":"wbw/092_017_001.mp3"},{"t":"ٱلْأَتْقَى","en":"the righteous","bn":"পরম মুত্তাকীকে","tr":"l-atqā","au":"wbw/092_017_002.mp3"}]},{"a":18,"w":[{"t":"ٱلَّذِى","en":"The one who","bn":"যে","tr":"alladhī","au":"wbw/092_018_001.mp3"},{"t":"يُؤْتِى","en":"gives","bn":"দান করে","tr":"yu'tī","au":"wbw/092_018_002.mp3"},{"t":"مَالَهُۥ","en":"his wealth","bn":"তার ধনসম্পদ","tr":"mālahu","au":"wbw/092_018_003.mp3"},{"t":