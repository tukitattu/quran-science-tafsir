{"surah":92,"src":"quran.com v4 (word-by-word EN/BN)","ayahs":[{"a":1,"w":[{"t":"وَٱلَّيْلِ","en":"By the night","bn":"শপথ রাতের","tr":"wa-al-layli","au":"wbw/092_001_001.mp3"},{"t":"إِذَا","en":"when","bn":"যখন","tr":"idhā","au":"wbw/092_001_002.mp3"},{"t":"يَغْشَىٰ","en":"it covers","bn":"আচ্ছন্ন করে","tr":"yaghshā","au":"wbw/092_001_003.mp3"}]},{"a":2,"w":[{"t":"وَٱلنَّهَارِ","en":"And the day","bn":"শপথ দিনের","tr":"wal-nahāri","au":"wbw/092_002_001.mp3"},{"t":"إِذَا","en":"when","bn":"যখন","tr":"idhā","au":"wbw/092_002_002.mp3"},{"t":"تَجَلَّىٰ","en":"it shines in brightness","bn":"আলোকিত হয়","tr":"tajallā","au":"wbw/092_002_003.mp3"}]},{"a":3,"w":[{"t":"وَمَا","en":"And He Who","bn":"শপথ তাঁর (যিনি)","tr":"wamā","au":"wbw/092_003_001.mp3"},{"t":"خَلَقَ","en":"created","bn":"সৃষ্টি করেছেন","tr":"khalaqa","au":"wbw/092_003_002.mp3"},{"t":"ٱلذَّكَرَ","en":"the male","bn":"পুরুষ","tr":"l-dhakara","au":"wbw/092_003_003.mp3"},{"t":"وَٱلْأُنثَىٰٓ","en":"and the female","bn":"ও নারী","tr":"wal-unthā","au":"wbw/092_003_004.mp3"}]},{"a":4,"w":[{"t":"إِنَّ","en":"Indeed","bn":"নিশ্চয়ই","tr":"inna","au":"wbw/092_004_001.mp3"},{"t":"سَعْيَكُمْ","en":"your efforts","bn":"তোমাদের কর্মপ্রচেষ্টা","tr":"saʿyakum","au":"wbw/092_004_002.mp3"},{"t":"لَشَتَّىٰ","en":"(are) surely diverse","bn":"অবশ্যই বিভিন্ন প্রকৃতির","tr":"lashattā","au":"wbw/092_004_003.mp3"}]},{"a":5,"w":[{"t":"فَأَمَّا","en":"Then as for","bn":"অতঃপর (তার) ক্ষেত্রে","tr":"fa-ammā","au":"wbw/092_005_001.mp3"},{"t":"مَنْ","en":"(him) who","bn":"যে","tr":"man","au":"wbw/092_005_002.mp3"},{"t":"أَعْطَىٰ","en":"gives","bn":"দান করলো","tr":"aʿṭā","au":"wbw/092_005_003.mp3"},{"t":"وَٱتَّقَىٰ","en":"and fears","bn":"ও খোদাভীরু হলো","tr":"wa-ittaqā","au":"wbw/092_005_004.mp3"}]},{"a":6,"w":[{"t":"وَصَدَّقَ","en":"And believes","bn":"এবং সত্য মানলো","tr":"waṣaddaqa","au":"wbw/092_006_001.mp3"},{"t":"بِٱلْحُسْنَىٰ","en":"in the best","bn":"উত্তমকে (ইসলামকে)","tr":"bil-ḥus'nā","au":"wbw/092_006_002.mp3"}]},{"a":7,"w":[{