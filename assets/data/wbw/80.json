{"surah":80,"src":"quran.com v4 (word-by-word EN/BN)","ayahs":[{"a":1,"w":[{"t":"عَبَسَ","en":"He frowned","bn":"সে ভ্রুকুঞ্চিত করল","tr":"ʿabasa","au":"wbw/080_001_001.mp3"},{"t":"وَتَوَلَّىٰٓ","en":"and turned away","bn":"ও (মুখ ফিরালো) অনাগ্রহ দেখালো","tr":"watawallā","au":"wbw/080_001_002.mp3"}]},{"a":2,"w":[{"t":"أَن","en":"Because","bn":"(এ জন্যে) যে","tr":"an","au":"wbw/080_002_001.mp3"},{"t":"جَآءَهُ","en":"came to him","bn":"তার (কাছে) এসেছে","tr":"jāahu","au":"wbw/080_002_002.mp3"},{"t":"ٱلْأَعْمَىٰ","en":"the blind man","bn":"এক অন্ধ","tr":"l-aʿmā","au":"wbw/080_002_003.mp3"}]},{"a":3,"w":[{"t":"وَمَا","en":"But what","bn":"এবং কিসে","tr":"wamā","au":"wbw/080_003_001.mp3"},{"t":"يُدْرِيكَ","en":"would make you know","bn":"তোমাকে জানাবে","tr":"yud'rīka","au":"wbw/080_003_002.mp3"},{"t":"لَعَلَّهُۥ","en":"that he might","bn":"সে হয়তো","tr":"laʿallahu","au":"wbw/080_003_003.mp3"},{"t":"يَزَّكَّىٰٓ","en":"purify himself","bn":"পরিশুদ্ধ হতো","tr":"yazzakkā","au":"wbw/080_003_004.mp3"}]},{"a":4,"w":[{"t":"أَوْ","en":"Or","bn":"বা","tr":"aw","au":"wbw/080_004_001.mp3"},{"t":"يَذَّكَّرُ","en":"be reminded","bn":"উপদেশ গ্রহণ করতো","tr":"yadhakkaru","au":"wbw/080_004_002.mp3"},{"t":"فَتَنفَعَهُ","en":"so would benefit him","bn":"তাকে অতঃপর উপকার দিত","tr":"fatanfaʿahu","au":"wbw/080_004_003.mp3"},{"t":"ٱلذِّكْرَىٰٓ","en":"the reminder","bn":"উপদেশ","tr":"l-dhik'rā","au":"wbw/080_004_004.mp3"}]},{"a":5,"w":[{"t":"أَمَّا","en":"As for","bn":"পক্ষান্তরে","tr":"ammā","au":"wbw/080_005_001.mp3"},{"t":"مَنِ","en":"(him) who","bn":"যে","tr":"mani","au":"wbw/080_005_002.mp3"},{"t":"ٱسْتَغْنَىٰ","en":"considers himself free from need","bn":"বেপরোয়া হলো (উন্নাসিকতা দেখালো)","tr":"is'taghnā","au":"wbw/080_005_003.mp3"}]},{"a":6,"w":[{"t":"فَأَنتَ","en":"So you","bn":"অথচ তুমি","tr":"fa-anta","au":"wbw/080_006_001.mp3"},{"t":"لَهُۥ","en":"to him","bn":"তার জন্যে","tr":"lahu","au":"wbw/080_006_002.mp3"},{"t":"تَصَدَّىٰ","en":"give attention","bn":"মনযোগ দিচ্ছো","tr":"taṣaddā